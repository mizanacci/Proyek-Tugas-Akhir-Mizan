# Firebase Realtime Database project scada-lbs.
FIREBASE_DATABASE_URL=https://scada-lbs-default-rtdb.asia-southeast1.firebasedatabase.app
# Local only: path to a service-account JSON stored OUTSIDE the repository.
# On hosted infrastructure prefer workload identity / a mounted secret file.
GOOGLE_APPLICATION_CREDENTIALS=./secrets/firebase-admin.json

# HiveMQ Cloud TLS endpoint. Do not add credentials to this URL.
MQTT_URL=mqtts://YOUR_HIVEMQ_HOST:8883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=scada-lbs-gateway-dev01

# One device is wired into the current Flutter screen/schema.
DEVICE_ID=LBS_01

# Safe default: receive and validate requests, write RECEIVED/DRY_RUN,
# but DO NOT publish any control command to the ESP32.
COMMAND_DISPATCH_ENABLED=false
# Fill these only after checking the actual ladder/wiring truth table.
# Values accepted by the current firmware are NO or NC.
OPEN_COMMAND_VALUE=
CLOSE_COMMAND_VALUE=

# A command older than this is expired rather than executed after downtime.
COMMAND_MAX_AGE_MS=60000
# Fresh sensor and COMFail state are required before any enabled dispatch.
DEVICE_STATUS_MAX_AGE_MS=15000
