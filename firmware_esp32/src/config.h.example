#ifndef CONFIG_H
#define CONFIG_H
#define ACS712_SUSPECT_CURRENT_A 1.8f
#define ACS712_MIN_DETECT_CURRENT_A 0.05f
#define ACS712_BOOT_IDLE_MAX_FUNDAMENTAL_MV 12.0f
#define ACS712_IDLE_CALIBRATION_FRAMES 3
#define ACS712_FUNDAMENTAL_HZ 50.0f
#define ACS712_CALIBRATION_VERIFIED 0
#include <Arduino.h>

#define PIN_MODBUS_RX2  18
#define PIN_MODBUS_TX2  17
// UART RS-232 melalui MAX3232: RX GPIO18, TX GPIO17.
// Nilai di config.h harus sama dengan kabel fisik.
#define MODBUS_BAUDRATE 9600
#define MODBUS_SLAVE_ID 1
// Jangan ubah ke SERIAL_8E1 tanpa menyamakan parity port PLC.
#define MODBUS_SERIAL_CONFIG SERIAL_8N1

#define REG_RMS_V_SUMBER   0
#define REG_RMS_V_BEBAN    1
#define REG_RMS_I_SUMBER   2
#define REG_RMS_I_BEBAN    3
#define REG_KUALITAS_DATA  4
#define REG_LRUFAIL        5
#define REG_CMD_REMOTE     6
#define REG_MODE_OPERASI_PLC 7
#define MODE_OPERASI_UNKNOWN 0U
#define MODE_OPERASI_STANDBY 1U
#define MODE_OPERASI_RUN 2U
#define MODE_OPERASI_INVALID 3U
#define MODE_OPERASI_PLC_TIMEOUT_MS 5000UL

#define SKALA_TEGANGAN   100.0f
#define SKALA_ARUS       1000.0f

#define BATAS_TEGANGAN_OFF  20.0f

#define JUMLAH_SAMPEL_RMS 200
#define INTERVAL_ADC_US 500
#define TARGET_SIKLUS_MS    1000
#define INTERVAL_PUBLISH_SENSOR_MS 5000

#define PIN_ADC_ZMPT_SUMBER 4
#define PIN_ADC_ZMPT_BEBAN 5
#define PIN_ADC_ACS_SUMBER 6
#define PIN_ADC_ACS_BEBAN 7

#define SENSOR_ADC_MIN_VALID_MV 100U
#define SENSOR_ADC_MAX_VALID_MV 3000U
#define SENSOR_BASELINE_TOLERANCE_MV 250.0f
#define MODE_DIAGNOSTIK_ARUS_NOL 0
#define SENSOR_ZERO_RMS_THRESHOLD_MV 5.0f

#define ZMPT_SUMBER_BASELINE_MV 1650.0f
#define ZMPT_BEBAN_BASELINE_MV 1650.0f
#define ACS712_SUMBER_BASELINE_MV 2300.0f
#define ACS712_BEBAN_BASELINE_MV 2300.0f

#define ZMPT_SUMBER_VOLTS_PER_MV_RMS 0.52945f
#define ZMPT_BEBAN_VOLTS_PER_MV_RMS 0.52028f
#define ACS712_SUMBER_AMPS_PER_MV_RMS (1.0f / 71.6f)
#define ACS712_BEBAN_AMPS_PER_MV_RMS (1.0f / 73.7f)

#define WIFI_SSID       "YOUR_WIFI_SSID"
#define WIFI_PASSWORD   "YOUR_WIFI_PASSWORD"
#define MQTT_HOST       "YOUR_HIVEMQ_HOST"
#define MQTT_PORT       8883
#define MQTT_USERNAME   "YOUR_MQTT_USERNAME"
#define MQTT_PASSWORD   "YOUR_MQTT_PASSWORD"
#define MQTT_CLIENT_ID  "esp32-scada-mizan-01"

#define TOPIC_DATA_SENSOR   "scada/mizan/data/sensor"
#define TOPIC_STATUS_LRUF  "scada/mizan/status/lrufail"
#define TOPIC_STATUS_COMF  "scada/mizan/status/comfail"
// LWT memakai TOPIC_STATUS_LRUF; TOPIC_STATUS_LWT dipertahankan agar config.h lokal lama valid.
#define TOPIC_STATUS_LWT   "scada/mizan/status/lwt"
#define TOPIC_CMD_REMOTE   "scada/mizan/cmd/relay"

#endif // CONFIG_H
