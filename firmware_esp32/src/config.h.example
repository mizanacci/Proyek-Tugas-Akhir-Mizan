#ifndef CONFIG_H
#define CONFIG_H
#include <Arduino.h>

#define PIN_I2C_SDA       8
#define PIN_I2C_SCL       9
#define ADS1115_I2C_ADDR  0x48

#define PIN_MODBUS_RX2  16
#define PIN_MODBUS_TX2  17
#define MODBUS_BAUDRATE 9600
#define MODBUS_SLAVE_ID 1

#define REG_RMS_V_SUMBER   0
#define REG_RMS_V_BEBAN    1
#define REG_RMS_I_SUMBER   2
#define REG_RMS_I_BEBAN    3
#define REG_KUALITAS_DATA  4
#define REG_LRUFAIL        5
#define REG_CMD_REMOTE     6

#define SKALA_TEGANGAN   100.0f
#define SKALA_ARUS       1000.0f

// Mode uji sensor DC DINONAKTIFKAN.
// Sistem utama menggunakan ZMPT101B AC pada A0/A1.
// #define MODE_UJI_SENSOR_DC_SUMBER
#define RASIO_PEMBAGI_SENSOR_DC  5.0f

// Koefisien ZMPT101B adalah placeholder sampai kalibrasi final.
#define ZMPT_SUMBER_GAIN    0.1f
#define ZMPT_SUMBER_OFFSET  0.0f
#define ZMPT_BEBAN_GAIN     0.1f
#define ZMPT_BEBAN_OFFSET   0.0f

// ACS712-20A nominal: 100 mV/A.
// RMS firmware menghilangkan DC bias secara otomatis dari setiap batch sampel,
// sehingga tidak lagi mengasumsikan titik tengah = ADC/2.
#define ACS712_MV_PER_AMP   100.0f

#define JUMLAH_SAMPEL_RMS   50
#define INTERVAL_ADC_US     2000
#define TARGET_SIKLUS_MS    1000

#define WIFI_SSID       "ISI_NILAI_DI_SINI"
#define WIFI_PASSWORD   "ISI_NILAI_DI_SINI"
#define MQTT_HOST       "ISI_NILAI_DI_SINI"
#define MQTT_PORT       8883
#define MQTT_USERNAME   "ISI_NILAI_DI_SINI"
#define MQTT_PASSWORD   "ISI_NILAI_DI_SINI"
#define MQTT_CLIENT_ID  "esp32-scada-mizan-01"

#define TOPIC_DATA_SENSOR   "scada/mizan/data/sensor"
#define TOPIC_STATUS_LRUF  "scada/mizan/status/lrufail"
#define TOPIC_STATUS_COMF  "scada/mizan/status/comfail"
#define TOPIC_STATUS_LWT   "scada/mizan/status/lwt"
#define TOPIC_CMD_REMOTE   "scada/mizan/cmd/relay"

#endif // CONFIG_H
