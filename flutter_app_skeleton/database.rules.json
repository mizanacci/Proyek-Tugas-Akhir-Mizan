{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": false
      }
    },
    "commands": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('isActive').val() == true && (root.child('users').child(auth.uid).child('role').val() == 'manager' || root.child('users').child(auth.uid).child('role').val() == 'operator')",
      ".indexOn": ["created_at"],
      "$commandId": {
        ".write": "auth != null && !data.exists() && root.child('users').child(auth.uid).child('isActive').val() == true && root.child('users').child(auth.uid).child('role').val() == 'operator' && newData.child('created_by_uid').val() == auth.uid && newData.child('created_by_name').val() == root.child('users').child(auth.uid).child('displayName').val() && newData.child('target').val() == 'LBS_01' && (newData.child('action').val() == 'OPEN' || newData.child('action').val() == 'CLOSE') && newData.child('status').val() == 'PENDING' && newData.child('created_at').val() == now",
        ".validate": "newData.hasChildren(['target','action','created_at','created_by_uid','created_by_name','status'])",
        "target": { ".validate": "newData.isString() && newData.val() == 'LBS_01'" },
        "action": { ".validate": "newData.isString() && (newData.val() == 'OPEN' || newData.val() == 'CLOSE')" },
        "created_at": { ".validate": "newData.isNumber() && newData.val() == now" },
        "created_by_uid": { ".validate": "newData.isString() && newData.val() == auth.uid" },
        "created_by_name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 120" },
        "status": { ".validate": "newData.isString() && newData.val() == 'PENDING'" },
        "$other": { ".validate": false }
      }
    },
    "command_results": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('isActive').val() == true && (root.child('users').child(auth.uid).child('role').val() == 'manager' || root.child('users').child(auth.uid).child('role').val() == 'operator')",
      ".indexOn": ["updated_at"]
    },
    "telemetry": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('isActive').val() == true && (root.child('users').child(auth.uid).child('role').val() == 'manager' || root.child('users').child(auth.uid).child('role').val() == 'operator')",
      "$deviceId": { ".indexOn": ["timestamp"] }
    },
    "data_activity": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('isActive').val() == true && (root.child('users').child(auth.uid).child('role').val() == 'manager' || root.child('users').child(auth.uid).child('role').val() == 'operator')",
      ".indexOn": ["timestamp"]
    }
  }
}
