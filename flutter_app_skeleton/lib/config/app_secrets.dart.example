class AppSecrets {
  static const String mqttManagerUsername = String.fromEnvironment(
    'MQTT_MANAGER_USERNAME',
    defaultValue: 'flutter-app-manager',
  );
  static const String mqttManagerPassword =
      String.fromEnvironment('MQTT_MANAGER_PASSWORD');
  static const String mqttOperatorUsername = String.fromEnvironment(
    'MQTT_OPERATOR_USERNAME',
    defaultValue: 'flutter-app-operator',
  );
  static const String mqttOperatorPassword =
      String.fromEnvironment('MQTT_OPERATOR_PASSWORD');
}
