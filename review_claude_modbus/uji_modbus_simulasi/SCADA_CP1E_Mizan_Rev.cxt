  VariableList:=
  BEGIN_LIST_$#[1]
   PB_LOCK,0.00,BOOL,,Push button LOCK (Hot Line = LOCK);
   PB_UNLOCK,0.01,BOOL,,Push button UNLOCK (Hot Line = UNLOCK);
   PB_NO,0.02,BOOL,,Push button NO (buka) hardwired - aktif saat LOCK;
   PB_NC,0.03,BOOL,,Push button NC (tutup) hardwired - aktif saat LOCK;
   RELAY_MY2N,100.00,BOOL,,Koil relay MY2N: ON = tutup (NC) dan OFF = buka (NO);
   HOT_LOCK,W0.00,BOOL,,Status Hot Line: 1 = LOCK dan 0 = UNLOCK;
   HOT_UNLOCK,W0.01,BOOL,,Status Hot Line: 1 = UNLOCK (kebalikan HOT_LOCK);
   CMD_NC_LOKAL,W0.03,BOOL,,Perintah tutup dari push button;
   CMD_NO_LOKAL,W0.04,BOOL,,Perintah buka dari push button;
   CMD_NC_HMI,W0.05,BOOL,,Perintah tutup dari HMI;
   CMD_NO_HMI,W0.06,BOOL,,Perintah buka dari HMI;
   CMD_NC_REMOTE,W0.07,BOOL,,Perintah tutup dari aplikasi (pulsa 1 scan);
   CMD_NO_REMOTE,W0.08,BOOL,,Perintah buka dari aplikasi (pulsa 1 scan);
   GATE_REMOTE,W0.09,BOOL,,Syarat jalur remote terpenuhi;
   LRUFAIL,W1.00,BOOL,,LRUFail: 1 = FAIL;
   COMFAIL,W1.01,BOOL,,COMFail: 1 = FAIL;
   MB_BUSY,W2.00,BOOL,,Transaksi Modbus sedang berjalan;
   MB_OK,W2.01,BOOL,,Pulsa transaksi Modbus selesai normal;
   MB_ERR,W2.02,BOOL,,Pulsa transaksi Modbus selesai error;
   MB_TIMEOUT,W2.03,BOOL,,Pulsa timeout transaksi Modbus;
   REMOTE_EVAL,W2.04,BOOL,,Pulsa evaluasi perintah remote;
   ARUS_NORMAL,W3.04,BOOL,,Arus beban normal: ada arus dan di bawah ambang D122 (usulan);
   I_GANGGUAN,W3.05,BOOL,,Arus Gangguan (I beban di atas ambang D122);
   V_ABNORMAL,W3.06,BOOL,,Tegangan sumber di luar batas D120-D121;
   LBS_SUSPECT,W3.07,BOOL,,Status LBS = SUSPECT (usulan);
   Q_VSUM,W5.00,BOOL,,Kualitas V sumber: 1 = SUSPECT;
   Q_VBEB,W5.01,BOOL,,Kualitas V beban: 1 = SUSPECT;
   Q_ISUM,W5.02,BOOL,,Kualitas I sumber: 1 = SUSPECT;
   Q_IBEB,W5.03,BOOL,,Kualitas I beban: 1 = SUSPECT;
   HMI_NO,W10.00,BOOL,,Tombol NO di HMI (ditulis oleh HMI);
   HMI_NC,W10.01,BOOL,,Tombol NC di HMI (ditulis oleh HMI);
   MB_STEP,D100,WORD,,Langkah sequencer Modbus;
   MB_STEP_NEXT,D105,WORD,,Langkah berikutnya sequencer Modbus;
   V_SUMBER,D110,WORD,,IREG 0: tegangan sumber x100;
   V_BEBAN,D111,WORD,,IREG 1: tegangan beban x100;
   I_SUMBER,D112,WORD,,IREG 2: arus sumber x1000;
   I_BEBAN,D113,WORD,,IREG 3: arus beban x1000;
   KUALITAS_IREG4,D114,WORD,,IREG 4: bitmask kualitas;
   LRUFAIL_IREG5,D115,WORD,,IREG 5: LRUFail (0 normal dan 1 fail);
   CMD_HREG6,D116,WORD,,HREG 6: perintah remote (1 = NO dan 2 = NC);
   BATAS_V_BAWAH,D120,WORD,,Batas bawah tegangan x100 (usulan 19800);
   BATAS_V_ATAS,D121,WORD,,Batas atas tegangan x100 (usulan 24200);
   AMBANG_I_GANGGUAN,D122,WORD,,Ambang Arus Gangguan x1000 (2000 = 2 A);
   V_ADA_MIN,D123,WORD,,Tegangan dianggap ada x100 (usulan 5000);
   I_GANGGUAN_NILAI,D131,WORD,,Nilai arus gangguan untuk HMI;
